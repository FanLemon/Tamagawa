[Unit]
Description=Tamagawa Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/OKCard
EnvironmentFile=/home/YOUR_USER/OKCard/.env
ExecStart=python3 -m uvicorn main:app --host 0.0.0.0 --port 3007
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
