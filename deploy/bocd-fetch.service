[Unit]
Description=Fetch BOCD exchange rates through the running API
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 120 --request POST http://127.0.0.1:3007/fetch_bocd_exchange_rates
TimeoutStartSec=130
